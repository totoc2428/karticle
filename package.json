{
  "name": "karticle",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "client_exemple"
  ],
  "scripts": {
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:client_exemple": "node scripts/dev-client-exemple.mjs",
    "build:frontend": "npm --workspace frontend run build",
    "build:widget": "npm --workspace frontend run build:widget",
    "preview:frontend": "npm --workspace frontend run preview",
    "dev:backend": "uvicorn app.main:app --app-dir backend --reload --host 0.0.0.0 --port 8000"
  }
}
