# Shared defaults
KARTICLE_ENV=development

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WIDGET_ORIGIN=http://localhost:5173
VITE_CLIENT_ARTICLE_ORIGIN=http://localhost:4173

# Local DNS + ports used by startup scripts
KARTICLE_BACKEND_DNS=localhost
KARTICLE_BACKEND_PORT=8000
KARTICLE_WIDGET_DNS=localhost
KARTICLE_WIDGET_PORT=5173
KARTICLE_CLIENT_DNS=localhost
KARTICLE_CLIENT_PORT=4173

# Backend
KARTICLE_BACKEND_HOST=0.0.0.0
KARTICLE_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173
KARTICLE_UNLOCK_TOKEN_TTL_DAYS=30
KARTICLE_PAYMENT_PROVIDER=stripe
KARTICLE_PAYMENT_WEBHOOK_SECRET=change-me
KARTICLE_PAYMENT_SECRET_KEY=change-me
KARTICLE_UNLOCK_COOKIE_MAX_AGE_DAYS=3650
